# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.output
stats.html
.wxt
web-ext.config.ts

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env
.env.*
!.env.example

# Local credentials for the v2 migration tooling (never commit).
# Deliberately NOT a .env file so WXT/Vite never loads it into a build.
.secrets/

# Chrome profiles holding a logged-in autodarts session:
#   .chrome-profile      scripts/dev-chrome.sh
#   .chrome-profile-dev  `yarn dev` (see webExt.chromiumProfile in wxt.config.ts)
#   .chrome-profile-pw   scripts/inspect.mjs
.chrome-profile*/

# DOM snapshots: the .html and .probe.json files ARE committed (they are the
# migration baseline and v1 is not recapturable once retired). The screenshots
# are not - 15MB of PNGs would grow every clone by ~50%. Regenerate locally with
#   node scripts/capture-dom.mjs
snapshots/**/*.png

# Signing certificates and provisioning profiles
*.p8
*.p12
*.cer
*.provisionprofile
*.mobileprovision
*.certSigningRequest

git2md

# Devtools build output (yarn build:devtools) — local install only
.output-devtools

# v1 reference build (yarn build:reference) — local only
.output-reference
